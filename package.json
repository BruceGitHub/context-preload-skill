{
  "name": "context-preload-skill",
  "version": "0.1.0",
  "description": "Route what an AI agent reads: declare flows in routing-context-flow.md and load only the files each task needs.",
  "type": "module",
  "bin": {
    "context-preload": "./bin/context-preload.ts"
  },
  "files": [
    "bin",
    "src",
    "editor",
    "scripts",
    "docs",
    "examples",
    "SKILL.md",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BruceGitHub/context-preload-skill.git"
  },
  "bugs": {
    "url": "https://github.com/BruceGitHub/context-preload-skill/issues"
  },
  "homepage": "https://github.com/BruceGitHub/context-preload-skill#readme",
  "scripts": {
    "test": "node --test",
    "typecheck": "tsc --noEmit",
    "build:routing": "node bin/context-preload.ts build",
    "build:editor": "node --disable-warning=ExperimentalWarning scripts/build-editor.mjs",
    "validate:examples": "node bin/context-preload.ts validate routing-context-flow.md && node bin/context-preload.ts validate examples/minimal-routing-context-flow.md",
    "check": "npm run typecheck && npm run build:routing && npm run build:editor && npm run validate:examples && npm test"
  },
  "keywords": [
    "ai",
    "agent",
    "context",
    "skill",
    "opencode",
    "claude-code",
    "routing",
    "llm",
    "prompt-engineering"
  ],
  "author": "BruceGitHub",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  }
}
